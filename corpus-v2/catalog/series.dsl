# Market series by name, each on its native calendar; read on a coarser or
# equal calendar as a bar view and on a finer one as of the bar (3.4).
class series {
  value(Name: Label, @T, V: Scalar)
  names "SPXTR" @1d, "VIX" @1w, "VIX_MA4" @1w, "SPX" @1d, "NDX" @1d, "NDXTR" @1d, "RUT" @1d, "RUTTR" @1d, "VIX_D" @1d, "DJI" @1d, "DJITR" @1d, "RUA" @1d, "RUATR" @1d, "COMP" @1d, "XCMP" @1d, "SML" @1d, "MID" @1d, "OEX" @1d, "VXN" @1d, "VVIX" @1d, "VIX9D" @1d, "VIX3M" @1d, "VIX6M" @1d, "VIX1Y" @1d, "VIX1D" @1d, "RVX" @1d, "OVX" @1d, "GVZ" @1d, "VXEEM" @1d, "VXEFA" @1d, "VXEWZ" @1d, "VXTLT" @1d
}
